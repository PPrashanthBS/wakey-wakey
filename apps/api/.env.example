# API Server Configuration
# Server port for the API
PORT=5555

# JWT Configuration
# Clerk JWT public key for token verification (Get from Clerk Dashboard)
# Format: -----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
JWT_PUBLIC_KEY="your-clerk-jwt-public-key"

# Solana Configuration
# Solana RPC connection URL (use devnet for testing)
CONNECTION_URL="https://api.devnet.solana.com"

# Solana wallet secret key for validator payments (base58 encoded)
SECRET_KEY="your-solana-wallet-secret-key"

# Database Configuration
# PostgreSQL connection URL
DATABASE_URL="postgresql://user:password@localhost:5432/wakey_wakey"
